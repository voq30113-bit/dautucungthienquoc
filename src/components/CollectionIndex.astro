---
/*
 * Shared body for collection index pages (page 1 and /trang/N/).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryRow from './EntryRow.astro';
import Pager from './Pager.astro';
import { vi } from '../i18n/vi';
import { type Entry, type Key, href } from '../lib/content';

interface Props {
  collection: Key;
  entries: Entry[];
  page: number;
  totalPages: number;
}
const { collection, entries, page, totalPages } = Astro.props;
const meta = vi.collections[collection];
const pageHref = (n: number) => href(n === 1 ? `${collection}/` : `${collection}/trang/${n}/`);
const title = page > 1 ? `${meta.title} · ${vi.ui.pageOf(page, totalPages)}` : meta.title;
---

<BaseLayout title={title} description={meta.description}>
  <div class="wrap">
    <header class="index-head">
      <p class="eyebrow">{meta.label}{page > 1 && ` · ${vi.ui.pageOf(page, totalPages)}`}</p>
      <h1>{meta.title}</h1>
      <p class="standfirst">{meta.description}</p>
    </header>

    {
      entries.length ? (
        <div class="list" data-reveal-stagger>
          {entries.map((e) => (
            <EntryRow entry={e} />
          ))}
        </div>
      ) : (
        <p class="empty">{vi.ui.empty}</p>
      )
    }

    {
      totalPages > 1 && (
        <Pager
          prev={page > 1 ? { href: pageHref(page - 1), title: vi.ui.pageOf(page - 1, totalPages) } : undefined}
          next={page < totalPages ? { href: pageHref(page + 1), title: vi.ui.pageOf(page + 1, totalPages) } : undefined}
          prevLabel={vi.ui.pagePrev}
          nextLabel={vi.ui.pageNext}
        />
      )
    }
  </div>
</BaseLayout>

<style>
  .index-head { padding: 44px 0 26px; border-bottom: 1px solid var(--line-strong); }
  .index-head .eyebrow { margin-bottom: 16px; }
  .index-head .standfirst { margin-top: 16px; }
  .empty {
    padding: 28px 0;
    font: 400 12px/1.6 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--ink-3-text);
    border-bottom: 1px solid var(--line);
  }
</style>
