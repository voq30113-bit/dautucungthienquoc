---
/*
 * Brand: logo mark + wordmark. The only place the brand is drawn — import it everywhere.
 *
 * The mark is a redrawn version of the owner's Canva logo (T whose stem runs
 * into a Q ring, the Q's tail rising as an arrow). It is inline SVG so it
 * follows the theme: the T uses --ink, ring and arrow use --accent.
 * The same geometry is used for public/favicon.svg — keep the two in sync.
 *
 * LOGO SWAP POINT
 * ---------------
 * To use a different logo, change only this file: replace the contents of
 * <slot name="mark"> below. Keep a text alternative (the wordmark spans, or
 * <span class="sr-only">{vi.site.name}</span>) so the link keeps its name.
 * A one-off override is also possible from any template:
 *   <Brand><svg slot="mark">…</svg></Brand>
 */
import { vi } from '../i18n/vi';
import { href as link } from '../lib/content';

interface Props {
  /** Link target; pass `null` for a static (non-link) wordmark. */
  href?: string | null;
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}
const { href = link(''), size = 'md', class: cls } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag class:list={['brand', 'plain', `brand-${size}`, cls]} href={href ?? undefined}>
  <slot name="mark">
    <svg class="brand-mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
      <g fill="none" stroke-width="4.4">
        <path class="t" d="M5 8.5H24M13 8.5V26" />
        <path class="q" d="M36.28 21.9A12 12 0 1 1 29.1 14.72" />
        <path class="q" d="M22 29L37.4 13.6" />
      </g>
      <path class="head" d="M43 8L40.88 17.2L33.8 10.12Z" />
    </svg>
    <span class="brand-words">
      <span class="brand-kicker">{vi.site.brandKicker}</span>
      <span class="brand-name">{vi.site.brandName}</span>
    </span>
  </slot>
  {href && <span class="sr-only"> — {vi.site.homeLabel}</span>}
</Tag>

<style>
  .brand {
    --kicker-size: 10.5px;
    --name-size: 1.72rem;
    display: inline-flex;
    align-items: center;
    gap: calc(var(--name-size) * 0.36);
    color: var(--ink);
    line-height: 1;
    background-image: none;
  }
  .brand-sm { --kicker-size: 9px; --name-size: 1.25rem; }
  .brand-lg { --kicker-size: 12px; --name-size: 2.3rem; }

  .brand-mark {
    flex: none;
    width: calc(var(--name-size) * 1.42);
    height: calc(var(--name-size) * 1.42);
    transition: width var(--dur-page) var(--ease-out), height var(--dur-page) var(--ease-out);
  }
  .brand-mark .t { stroke: currentColor; }
  .brand-mark .q { stroke: var(--accent); }
  .brand-mark .head { fill: var(--accent); }

  .brand-words { display: inline-flex; flex-direction: column; justify-content: center; }
  .brand-kicker {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--kicker-size);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-variant-caps: all-small-caps;
    color: var(--accent);
    margin-bottom: 0.32em;
    transition: font-size var(--dur-page) var(--ease-out), margin var(--dur-page) var(--ease-out);
  }
  .brand-name {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: var(--name-size);
    letter-spacing: -0.012em;
    line-height: 0.95;
    transition: font-size var(--dur-page) var(--ease-out);
  }
  /* all-small-caps shrinks the caps; compensate so the kicker reads at size. */
  @supports (font-variant-caps: all-small-caps) {
    .brand-kicker { font-size: calc(var(--kicker-size) * 1.28); }
  }
</style>
