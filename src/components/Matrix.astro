---
/*
 * Impact matrix. Cells take '++', '+', '0', '−', '−−' (ASCII '-' is accepted).
 *
 * <Matrix caption="Tác động theo ngành" columns={['Lãi suất', 'Tỷ giá']}
 *   rows={[{ label: 'Ngân hàng', cells: ['+', '−'] }]} />
 */
import { vi } from '../i18n/vi';

interface Props {
  caption: string;
  columns: string[];
  rows: { label: string; cells: string[] }[];
  rowHeader?: string;
}
const { caption, columns, rows, rowHeader = '' } = Astro.props;

const norm = (s: string) => s.trim().replace(/-/g, '−');
const cls = (s: string) =>
  ({ '++': 'pp', '+': 'p', '0': 'z', '−': 'n', '−−': 'nn' })[norm(s)] ?? 'z';
const legend = vi.components.matrixLegend;
const legendLabel = (s: string) => legend.find(([k]) => k === norm(s))?.[1] ?? s;
---

<figure class="matrix keep">
  <div class="mx-scroll" tabindex="0" role="region" aria-label={caption}>
    <table>
      <caption class="caption">{caption}</caption>
      <thead>
        <tr>
          <th scope="col" class="rh">{rowHeader}</th>
          {columns.map((c) => <th scope="col">{c}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr>
              <th scope="row" class="rh">{row.label}</th>
              {row.cells.map((c) => (
                <td class={cls(c)} title={legendLabel(c)}>
                  <span aria-hidden="true">{norm(c)}</span>
                  <span class="sr-only">{legendLabel(c)}</span>
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <figcaption class="legend">
    {
      legend.map(([k, label]) => (
        <span class="lg">
          <span class:list={['sw', cls(k)]} aria-hidden="true">{k}</span>
          {label}
        </span>
      ))
    }
  </figcaption>
</figure>

<style>
  .matrix { margin-inline: 0; margin-bottom: 0; }
  .mx-scroll { position: relative; overflow-x: auto; border: 1px solid var(--line); background: var(--surface); }
  table { width: 100%; font-size: 14px; }
  caption {
    caption-side: top;
    text-align: left;
    padding: 12px 14px 10px;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  thead th {
    font: 500 10.5px/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3-text);
    padding: 10px 10px 9px;
    text-align: center;
    border-bottom: 1px solid var(--line-strong);
    min-width: 86px;
  }
  th.rh, thead th.rh { text-align: left; padding-left: 14px; }
  tbody th {
    font-weight: 500;
    white-space: nowrap;
    padding: 9px 14px;
    border-top: 1px solid var(--line);
  }
  td {
    text-align: center;
    font: 600 13px/1 var(--font-mono);
    padding: 10px;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  tbody tr:first-child > * { border-top: 0; }
  .pp { background: var(--up-soft); color: var(--up-text); }
  .p { color: var(--up-text); }
  .z { color: var(--ink-3-text); }
  .n { color: var(--down-text); }
  .nn { background: var(--down-soft); color: var(--down-text); }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 10px;
    font: 400 11px/1.5 var(--font-mono);
    letter-spacing: 0.03em;
    color: var(--ink-3-text);
  }
  .lg { display: inline-flex; align-items: center; gap: 7px; }
  .sw {
    display: inline-grid;
    place-items: center;
    min-width: 26px;
    height: 20px;
    padding: 0 4px;
    border: 1px solid var(--line);
    border-radius: 2px;
    font-weight: 600;
  }
</style>
