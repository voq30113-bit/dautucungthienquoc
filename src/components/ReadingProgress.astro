---
/*
 * 2px accent bar at the top of article pages, driven by scroll position
 * through the element marked [data-progress-target].
 */
import { vi } from '../i18n/vi';
---

<div class="progress" aria-hidden="true" data-progress title={vi.ui.progress}>
  <span class="bar" data-progress-bar></span>
</div>

<script>
  let cleanup: (() => void) | null = null;

  function init() {
    cleanup?.();
    cleanup = null;
    const bar = document.querySelector<HTMLElement>('[data-progress-bar]');
    const target = document.querySelector<HTMLElement>('[data-progress-target]');
    if (!bar || !target) return;

    let start = 0;
    let span = 1;
    const measure = () => {
      const rect = target.getBoundingClientRect();
      start = rect.top + window.scrollY - 80;
      span = Math.max(1, rect.height - window.innerHeight * 0.6);
    };
    let queued = false;
    let idle: number | undefined;
    const paint = () => {
      queued = false;
      const p = Math.min(1, Math.max(0, (window.scrollY - start) / span));
      bar.style.transform = `scaleX(${p})`;
    };
    const onScroll = () => {
      bar.style.willChange = 'transform';
      window.clearTimeout(idle);
      idle = window.setTimeout(() => (bar.style.willChange = 'auto'), 200);
      if (!queued) {
        queued = true;
        requestAnimationFrame(paint);
      }
    };
    const onResize = () => {
      measure();
      paint();
    };
    measure();
    paint();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize, { passive: true });
    // Fonts can change article height after first measure.
    document.fonts?.ready.then(onResize);
    cleanup = () => {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onResize);
      window.clearTimeout(idle);
    };
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => cleanup?.());
</script>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 60;
    pointer-events: none;
  }
  .bar {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
  }
  @media (prefers-reduced-motion: reduce) {
    .progress { display: none; }
  }
</style>
