---
/*
 * <SectorBlock name="Ngân hàng" verdict="pos" weight="Tỷ trọng ~ 36% VN-Index"
 *   drivers={[{ key: 'Tín dụng', text: 'Tăng trưởng 11,2% YTD…' }]}>
 *   Optional prose.
 * </SectorBlock>
 */
import { vi } from '../i18n/vi';

interface Props {
  name: string;
  verdict: 'pos' | 'neu' | 'neg';
  weight?: string;
  drivers?: { key: string; text: string }[];
}
const { name, verdict, weight, drivers = [] } = Astro.props;
const pill = { pos: 'pos', neu: '', neg: 'neg' }[verdict];
---

<section class="sector keep">
  <div class="head">
    <h4>{name}</h4>
    <span class:list={['pill', pill]}>{vi.components.verdict[verdict]}</span>
    {weight && <span class="weight">{weight}</span>}
  </div>
  {Astro.slots.has('default') && <div class="body"><slot /></div>}
  {
    drivers.length > 0 && (
      <dl class="drivers">
        {drivers.map((d) => (
          <div class="drv">
            <dt>{d.key}</dt>
            <dd>{d.text}</dd>
          </div>
        ))}
      </dl>
    )
  }
</section>

<style>
  .sector { border-top: 1px solid var(--line-strong); padding: 16px 0 6px; }
  .sector + :global(.sector) { margin-top: 10px; }
  .head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
  h4 { margin: 0 !important; }
  .weight {
    margin-left: auto;
    font: 400 11.5px/1.4 var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--ink-3-text);
  }
  .body { margin-top: 10px; max-width: 68ch; color: var(--ink-2); }
  .body > :global(* + *) { margin-top: 0.6em; }
  .drivers { margin-top: 12px; }
  .drv {
    display: grid;
    grid-template-columns: 94px 1fr;
    gap: 2px 14px;
    padding: 8px 0;
    border-top: 1px solid var(--line);
  }
  dt {
    font: 500 11px/1.6 var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    padding-top: 0.15em;
  }
  dd { margin: 0; font-size: 15px; line-height: 1.6; max-width: 62ch; }
  @media (max-width: 640px) {
    .drv { grid-template-columns: 1fr; }
    .weight { margin-left: 0; flex-basis: 100%; }
  }
</style>
