---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCalendar from '../components/EventCalendar.astro';
import KeyPoints from '../components/KeyPoints.astro';
import { vi } from '../i18n/vi';
import { href } from '../lib/content';
---

<BaseLayout title={vi.about.title} description={vi.about.description}>
  <div class="wrap">
    <header class="index-head">
      <p class="eyebrow">{vi.about.title}</p>
      <h1>Về {vi.site.name}</h1>
      <p class="standfirst">
        Nghiên cứu thị trường chứng khoán Việt Nam độc lập, dựa trên dữ liệu công khai và trình bày điềm tĩnh. Ưu tiên
        bằng chứng hơn cảm xúc, số liệu hơn dự đoán.
      </p>
    </header>

    <div class="prose">
      <h2 id="trang-nay-la-gi">Trang này là gì</h2>
      <p>
        {vi.site.name} là nơi {vi.site.author} xuất bản các ghi chú thị trường hằng ngày và báo cáo vĩ mô hằng tuần về
        chứng khoán Việt Nam. Mỗi bài viết tổng hợp dữ liệu giao dịch, thông tin chính sách và diễn biến quốc tế thành
        một bức tranh ngắn gọn, có nguồn rõ ràng, để người đọc tự đưa ra đánh giá của mình.
      </p>

      <h2 id="lich-xuat-ban">Lịch xuất bản</h2>
      <EventCalendar
        items={[
          { date: '07:00', title: vi.collections['nhan-dinh'].title, sub: 'Thứ Hai đến Thứ Sáu, trước giờ mở cửa' },
          { date: '16:30', title: vi.collections['tong-ket'].title, sub: 'Thứ Hai đến Thứ Sáu, sau khi đóng cửa' },
          { date: '20:00', title: vi.collections['bao-cao'].title, sub: 'Chủ nhật, cho tuần giao dịch tiếp theo' },
          { date: '—', title: vi.collections['phan-tich'].title, sub: 'Không theo lịch cố định' },
        ]}
      />

      <h2 id="phuong-phap">Phương pháp</h2>
      <p>
        Số liệu được lấy từ các nguồn công khai: dữ liệu giao dịch của các sở giao dịch, thông cáo của cơ quan quản lý,
        số liệu thống kê chính thức, báo cáo của doanh nghiệp niêm yết và báo chí tài chính trong và ngoài nước. Mỗi bài
        liệt kê nguồn ở cuối trang. Các con số thị trường được ghi nhận tại thời điểm đóng cửa của phiên được nêu trong
        bài.
      </p>
      <p>
        Khi một bài đã đăng được sửa đổi, thẻ <strong>{vi.ui.revision}</strong> ở đầu bài cho biết nội dung thay đổi.
      </p>

      <h2 id="nguyen-tac">Nguyên tắc biên tập</h2>
      <KeyPoints
        items={[
          'Dữ liệu trước, nhận định sau. Mọi nhận định đều gắn với con số hoặc sự kiện cụ thể.',
          'Nêu rõ nguồn. Người đọc có thể kiểm tra lại từng số liệu quan trọng.',
          'Trình bày kịch bản và rủi ro, không đưa ra khuyến nghị mua hay bán.',
          'Ghi rõ khi sửa đổi, không lặng lẽ thay nội dung đã đăng.',
        ]}
      />

      <h2 id="mien-tru">{vi.disclaimer.title}</h2>
      <p>{vi.disclaimer.text}</p>

      <h2 id="theo-doi">Theo dõi</h2>
      <p>
        Bạn có thể theo dõi bài mới qua <a href={href('rss.xml')}>nguồn cấp RSS</a>, hoặc duyệt toàn bộ bài viết trong
        mục <a href={href('luu-tru/')}>{vi.archive.title}</a>.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .index-head { padding: 44px 0 10px; }
  .index-head .eyebrow { margin-bottom: 16px; }
  .index-head .standfirst { margin-top: 16px; }
</style>
