---
import { ClientRouter, fade } from 'astro:transitions';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import { vi } from '../i18n/vi';
import { absolute, href } from '../lib/content';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Site-relative path used for the canonical URL; defaults to the current path. */
  path?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  section?: string;
  tags?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description = vi.site.description,
  type = 'website',
  publishedTime,
  modifiedTime,
  section,
  tags = [],
  jsonLd,
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const path = Astro.props.path ?? Astro.url.pathname.slice(base.length).replace(/^\/+/, '');
const canonical = absolute(path, Astro.site);
const fullTitle = title ? `${title} · ${vi.site.name}` : `${vi.site.name} — ${vi.site.tagline}`;

const FONTS =
  'https://fonts.googleapis.com/css2' +
  '?family=Be+Vietnam+Pro:wght@300;400;500;600;700' +
  '&family=IBM+Plex+Mono:wght@400;500;600' +
  '&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400' +
  '&subset=vietnamese,latin,latin-ext&display=swap';

const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#F1F2EF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0F1311" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={vi.site.name} href={href('rss.xml')} />
    <link rel="sitemap" href={href('sitemap.xml')} />

    <meta property="og:site_name" content={vi.site.name} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? vi.site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {section && <meta property="article:section" content={section} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title ?? vi.site.name} />
    <meta name="twitter:description" content={description} />

    <!-- Apply the stored theme before first paint (no flash). -->
    <script is:inline>
      (function () {
        function apply(doc) {
          try {
            var t = localStorage.getItem('theme');
            if (t === 'light' || t === 'dark') doc.documentElement.setAttribute('data-theme', t);
          } catch (e) {}
        }
        apply(document);
        if (!window.__tqTheme) {
          window.__tqTheme = 1;
          document.addEventListener('astro:before-swap', function (e) { apply(e.newDocument); });
        }
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={FONTS} />

    <ClientRouter />
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <a class="skip" href="#main">{vi.ui.skip}</a>
    <Masthead />
    <slot name="top" />
    <main id="main" tabindex="-1" transition:name="content" transition:animate={fade({ duration: '0.4s' })}>
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>

<style>
  main:focus { outline: none; }
</style>
